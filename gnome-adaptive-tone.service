[Unit]
Description=GNOME Adaptive Tone Daemon (Ambient Color Temperature matching)
After=graphical-session.target gnome-session.target org.gnome.Shell@wayland.service
PartOf=graphical-session.target
# Stop retrying (e.g. no CCT sensor present) instead of restarting every 3s forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/gnome-adaptive-tone
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical-session.target
