def get_extension_settings():
    """Attempt to load GSettings for Adaptive Tone extension if schema is installed."""
    try:
        source = Gio.SettingsSchemaSource.get_default()
        if source and source.lookup(EXTENSION_SCHEMA, True):
            return Gio.Settings(schema_id=EXTENSION_SCHEMA)
    except Exception as e:
        logger.debug(f"Could not load extension settings: {e}")
    return None


class AdaptiveToneSensor:
    def __init__(self):
        self.device_path = None
        self.device_name = "unknown"
        self.raw_path = None
        self.cct_scale = 0.001
        self.lux_raw_path = None
        self.lux_scale = 0.001
        self._find_sensor()

    def _find_sensor(self):
        candidates = []
        for dev in sorted(glob.glob('/sys/bus/iio/devices/iio:device*')):
            raw_p = os.path.join(dev, 'in_colortemp_raw')
            if os.path.exists(raw_p):
                name_p = os.path.join(dev, 'name')
                name = "unknown"
                if os.path.exists(name_p):
                    try:
                        with open(name_p, 'r') as f:
                            name = f.read().strip()
                    except Exception:
                        pass
                candidates.append((dev, name, raw_p))

        if not candidates:
            raise RuntimeError("No hardware color temperature (CCT) sensor found under /sys/bus/iio/devices/")

        # Prefer ALS named devices
        selected = candidates[0]
        for dev, name, raw_p in candidates:
            if 'als' in name.lower() or 'light' in name.lower():
                selected = (dev, name, raw_p)
                break

        self.device_path, self.device_name, self.raw_path = selected
        
        # Cache CCT scale once at startup
        scale_path = os.path.join(self.device_path, 'in_colortemp_scale')
        if os.path.exists(scale_path):
            try:
                with open(scale_path, 'r') as f:
                    self.cct_scale = float(f.read().strip())
            except Exception:
                self.cct_scale = 0.001
        
        # Cache Lux scale once at startup
        lux_p = os.path.join(self.device_path, 'in_illuminance_raw')
        if os.path.exists(lux_p):
            self.lux_raw_path = lux_p
            lux_scale_path = os.path.join(self.device_path, 'in_illuminance_scale')
            if os.path.exists(lux_scale_path):
                try:
                    with open(lux_scale_path, 'r') as f:
                        self.lux_scale = float(f.read().strip())
                except Exception:
                    self.lux_scale = 0.001

    def read_color_temp(self) -> float:
        with open(self.raw_path, 'r') as f:
            raw = float(f.read().strip())
        return raw * self.cct_scale

    def read_illuminance(self) -> float:
        if not self.lux_raw_path:
            return 100.0
        try:
            with open(self.lux_raw_path, 'r') as f:
                raw = float(f.read().strip())
            return raw * self.lux_scale
        except Exception:
            return 100.0


class GnomeColorController:
    SCHEMA = 'org.gnome.settings-daemon.plugins.color'

    def __init__(self, save_state: bool = True):
        self.settings = Gio.Settings(schema_id=self.SCHEMA)
        self._ensure_state_dir()
        if save_state:
            self._save_original_state()

    def _ensure_state_dir(self):
        if not os.path.exists(CONFIG_DIR):
            os.makedirs(CONFIG_DIR, exist_ok=True)
        if not os.path.exists(STATE_FILE) and os.path.exists(OLD_STATE_FILE):
            try:
                shutil.copy2(OLD_STATE_FILE, STATE_FILE)
            except Exception:
                pass

    def _save_original_state(self):
        if not os.path.exists(STATE_FILE):
            state = {
                'night-light-enabled': self.settings.get_boolean('night-light-enabled'),
                'night-light-schedule-automatic': self.settings.get_boolean('night-light-schedule-automatic'),
                'night-light-temperature': self.settings.get_uint('night-light-temperature'),
                'night-light-schedule-from': self.settings.get_double('night-light-schedule-from'),
                'night-light-schedule-to': self.settings.get_double('night-light-schedule-to'),
            }
            with open(STATE_FILE, 'w') as f:
                json.dump(state, f, indent=4)
            logger.info(f"Saved original GNOME color settings to {STATE_FILE}")

    def enable_all_day_mode(self):
        """Configure GNOME Night Light for 24/7 dynamic control (Check-Before-Write)."""
        if not self.settings.get_boolean('night-light-enabled'):
            self.settings.set_boolean('night-light-enabled', True)
        if self.settings.get_boolean('night-light-schedule-automatic'):
            self.settings.set_boolean('night-light-schedule-automatic', False)
        if self.settings.get_double('night-light-schedule-from') != 0.0:
            self.settings.set_double('night-light-schedule-from', 0.0)
        if self.settings.get_double('night-light-schedule-to') != 24.0:
            self.settings.set_double('night-light-schedule-to', 24.0)

    def set_temperature(self, kelvin: int):
        kelvin = max(1000, min(10000, int(kelvin)))
        self.settings.set_uint('night-light-temperature', kelvin)

    def get_temperature(self) -> int:
        return self.settings.get_uint('night-light-temperature')

    def restore_original_settings(self):
        """Restore original user settings when daemon or master switch is turned off."""
        if os.path.exists(STATE_FILE):
            try:
                with open(STATE_FILE, 'r') as f:
                    state = json.load(f)
                self.settings.set_boolean('night-light-enabled', state.get('night-light-enabled', False))
                self.settings.set_boolean('night-light-schedule-automatic', state.get('night-light-schedule-automatic', True))
                self.settings.set_uint('night-light-temperature', state.get('night-light-temperature', 6500))
                self.settings.set_double('night-light-schedule-from', state.get('night-light-schedule-from', 0.0))
                self.settings.set_double('night-light-schedule-to', state.get('night-light-schedule-to', 0.0))
                os.remove(STATE_FILE)
                logger.info("Original GNOME color settings restored successfully.")
            except Exception as e:
                logger.error(f"Error restoring original settings: {e}")
        else:
            # No snapshot means settings were already restored (e.g. master switch turned off
            # before exit). Leave the user's current Night Light configuration untouched.
            logger.info("No saved state to restore; leaving GNOME color settings unchanged.")
        # dconf writes are asynchronous; flush them so a restore right before exit is not lost.
        Gio.Settings.sync()


def map_ambient_to_display_cct(ambient_k: float, config: dict) -> int:
    """
    SmoothStep transfer function with fine-tuning offset:
    Maps ambient light CCT (2500K-7000K) to comfortable display CCT (3800K-6500K)
    and applies temp_offset (+ for cooler, - for warmer).
    """
    a_min = config['ambient_min']
    a_max = config['ambient_max']
    d_min = config['display_min']
    d_max = config['display_max']
    offset = config.get('temp_offset', 0)

    # Clamp ambient to range [0.0, 1.0]
    if a_max == a_min:
        t = 0.5
    else:
        t = max(0.0, min(1.0, (ambient_k - a_min) / (a_max - a_min)))

    # SmoothStep curve: S-curve transition
    smooth_t = t * t * (3.0 - 2.0 * t)

    # Map to display CCT
    mapped_k = d_min + smooth_t * (d_max - d_min)

    # Apply user tone offset and clamp to hardware safe bounds
    final_k = int(round(mapped_k + offset))
    return max(1000, min(10000, final_k))


def is_in_time_schedule(from_hour: int, from_minute: int, to_hour: int, to_minute: int, now: datetime.datetime = None) -> tuple[bool, int]:
    """
    Check if current time is within schedule and calculate seconds until the next transition.
    Supports cross-midnight schedules (e.g. 22:00 -> 07:00).
    Returns (is_active, seconds_until_next_event).
    """
    if now is None:
        now = datetime.datetime.now()

    current_time = now.time()
    start_time = datetime.time(from_hour, from_minute)
    end_time = datetime.time(to_hour, to_minute)

    if start_time == end_time:
        # Same start and end means never active (0-duration schedule)
        return False, 3600

    if start_time < end_time:
        in_range = (start_time <= current_time < end_time)
    else:
        # Crosses midnight (e.g. 22:00 to 07:00)
        in_range = (current_time >= start_time or current_time < end_time)

    next_time = end_time if in_range else start_time
    target_dt = now.replace(hour=next_time.hour, minute=next_time.minute, second=0, microsecond=0)
    if target_dt <= now:
        target_dt += datetime.timedelta(days=1)

    delta_sec = max(1, int((target_dt - now).total_seconds()))
    return in_range, delta_sec


class AdaptiveToneDaemon:
    def __init__(self, config: dict = None, use_gsettings: bool = True):
        self.config = dict(DEFAULT_CONFIG)
        if config:
            self.config.update(config)

        self.sensor = AdaptiveToneSensor()
        self.controller = GnomeColorController()
        
        # State tracking
        self.current_display_k = float(self.controller.get_temperature())
        self.last_stable_ambient_k = self.sensor.read_color_temp()
        self.last_stable_lux = self.sensor.read_illuminance()
        self.pending_ambient_k = None
        self.pending_since = 0.0
        self.fallback_suppressed_count = 0
        
        self.occlusion_start_time = None
        self.is_sleeping = False
        self.resume_timer_id = None
        self.polling_timer_id = None
        self.schedule_timer_id = None
        self.occlusion_timer_id = None
        self.is_in_night_schedule = False
        self._cleaned_up = False
        
        # D-Bus & Loop
        self.loop = None
        self.system_bus = None
        self.sensor_proxy = None
        
        # GSettings Extension integration
        self.ext_settings = get_extension_settings() if use_gsettings else None
        if self.ext_settings:
            self._bind_extension_settings()
            logger.info("Connected to GNOME Extension GSettings schema for real-time configuration.")

        # Initialize schedule status
        self._evaluate_night_schedule()

    def _is_hardware_fallback(self, raw_cct: float, lux: float) -> bool:
        """
        Detect hardware sensor fallback anomaly (e.g. Intel ISH ALS reporting fixed
        4500K baseline under low light < 60lx when sensor SNR degrades).
        """
        if not self.config.get('fallback_cct_filter', True):
            return False

        target_cct = self.config.get('fallback_cct_val', 4500)
        max_lux = self.config.get('fallback_max_lux', 60.0)
        min_jump = self.config.get('fallback_min_jump', 800)
        min_lux_rise = self.config.get('fallback_min_lux_rise', 15.0)

        # 1. Reading must match the fixed fallback Kelvin (e.g. 4500K ± 50K)
        if abs(raw_cct - target_cct) >= 50.0:
            return False

        # 2. Must be in low-light conditions
        if lux >= max_lux:
            return False

        # 3. Must be a large discontinuous jump from current stable ambient CCT
        if self.last_stable_ambient_k is not None:
            jump = abs(raw_cct - self.last_stable_ambient_k)
            if jump < min_jump:
                # Ambient was already stable near 4500K; not an abnormal fallback jump
                return False

        # 4. Illuminance did not significantly increase
        # A genuine physical light source turning on in a dark room would noticeably increase lux
        if self.last_stable_lux is not None:
            lux_rise = lux - self.last_stable_lux
            if lux_rise >= min_lux_rise:
                return False

        return True

    def _bind_extension_settings(self):
        """Listen to GSettings changes from the GNOME Shell extension preferences."""
        def on_setting_changed(settings, key):
            schema = settings.get_property('settings-schema') if hasattr(settings, 'get_property') else None
            if key == 'enabled':
                enabled = settings.get_boolean('enabled')
                self.config['enabled'] = enabled
                logger.info(f"Extension Master switch toggled: {'ENABLED' if enabled else 'DISABLED'}")
                if enabled:
                    self.controller._save_original_state()
                    self._evaluate_night_schedule(force=True)
                    if not self.is_in_night_schedule:
                        self._sync_now("Master Enabled", force=True)
                    self.controller.enable_all_day_mode()
                else:
                    self.controller.restore_original_settings()
                    self.current_display_k = float(self.controller.get_temperature())
            elif key == 'temp-offset':
                self.config['temp_offset'] = settings.get_int('temp-offset')
                logger.info(f"Config updated: temp_offset = {self.config['temp_offset']}K")
                if self.config.get('enabled', True):
                    self._sync_now("Offset Change")
            elif key == 'update-threshold':
                self.config['update_threshold'] = settings.get_int('update-threshold')
                logger.info(f"Config updated: update_threshold = {self.config['update_threshold']}K")
            elif key == 'glitch-threshold' and schema and schema.has_key('glitch-threshold'):
                self.config['glitch_threshold'] = settings.get_int('glitch-threshold')
                logger.info(f"Config updated: glitch_threshold = {self.config['glitch_threshold']}K")
            elif key == 'glitch-confirm-sec' and schema and schema.has_key('glitch-confirm-sec'):
                self.config['glitch_confirm_sec'] = settings.get_double('glitch-confirm-sec')
                logger.info(f"Config updated: glitch_confirm_sec = {self.config['glitch_confirm_sec']}s")
            elif key == 'display-min':
                self.config['display_min'] = settings.get_int('display-min')
                if self.config.get('enabled', True):
                    self._sync_now("Display Range Change")
            elif key == 'display-max':
                self.config['display_max'] = settings.get_int('display-max')
                if self.config.get('enabled', True):
                    self._sync_now("Display Range Change")
            elif key == 'ambient-min':
                self.config['ambient_min'] = settings.get_int('ambient-min')
                if self.config.get('enabled', True):
                    self._sync_now("Ambient Range Change")
            elif key == 'ambient-max':
                self.config['ambient_max'] = settings.get_int('ambient-max')
                if self.config.get('enabled', True):
                    self._sync_now("Ambient Range Change")
            elif key == 'min-lux-threshold':
                self.config['min_lux_threshold'] = settings.get_double('min-lux-threshold')
            elif key == 'occlusion-hold-sec':
                self.config['occlusion_hold_sec'] = settings.get_double('occlusion-hold-sec')
            elif key == 'resume-delay-sec':
                self.config['resume_delay_sec'] = settings.get_double('resume-delay-sec')
            elif key in ('enable-polling', 'poll-interval'):
                self.config['enable_polling'] = settings.get_boolean('enable-polling')
                self.config['poll_interval'] = settings.get_int('poll-interval')
                self._update_polling_timer()
            elif key in (
                'night-schedule-enabled', 'night-schedule-from-hour', 'night-schedule-from-minute',
                'night-schedule-to-hour', 'night-schedule-to-minute', 'night-schedule-temp'
            ):
                if schema:
                    if schema.has_key('night-schedule-enabled'):
                        self.config['night_schedule_enabled'] = settings.get_boolean('night-schedule-enabled')
                    if schema.has_key('night-schedule-from-hour'):
                        self.config['night_schedule_from_hour'] = settings.get_int('night-schedule-from-hour')
                    if schema.has_key('night-schedule-from-minute'):
                        self.config['night_schedule_from_minute'] = settings.get_int('night-schedule-from-minute')
                    if schema.has_key('night-schedule-to-hour'):
                        self.config['night_schedule_to_hour'] = settings.get_int('night-schedule-to-hour')
                    if schema.has_key('night-schedule-to-minute'):
                        self.config['night_schedule_to_minute'] = settings.get_int('night-schedule-to-minute')
                    if schema.has_key('night-schedule-temp'):
                        self.config['night_schedule_temp'] = settings.get_int('night-schedule-temp')
                logger.info(
                    f"Night schedule config updated: enabled={self.config['night_schedule_enabled']}, "
                    f"{self.config['night_schedule_from_hour']:02d}:{self.config['night_schedule_from_minute']:02d} ~ "
                    f"{self.config['night_schedule_to_hour']:02d}:{self.config['night_schedule_to_minute']:02d}, "
                    f"temp={self.config['night_schedule_temp']}K"
                )
                # Force so a new temperature/window applies immediately even if already inside it.
                self._evaluate_night_schedule(force=True)

        self.ext_settings.connect('changed', on_setting_changed)

    def _evaluate_night_schedule(self, force: bool = False):
        """Evaluate night schedule status, transition color temperature, and register the next timer."""
        if self.schedule_timer_id:
            GLib.source_remove(self.schedule_timer_id)
            self.schedule_timer_id = None

        if not self.config.get('night_schedule_enabled', False):
            if self.is_in_night_schedule:
                logger.info("Night schedule disabled. Resuming adaptive tone.")
                self.is_in_night_schedule = False
                if self.config.get('enabled', True):
                    self._sync_now("Night Schedule Disabled", force=True)
            return

        now = datetime.datetime.now()
        in_range, delta_sec = is_in_time_schedule(
            self.config['night_schedule_from_hour'],
            self.config['night_schedule_from_minute'],
            self.config['night_schedule_to_hour'],
            self.config['night_schedule_to_minute'],
            now
        )

        state_changed = (self.is_in_night_schedule != in_range)
        self.is_in_night_schedule = in_range

        if in_range:
            target_k = self.config.get('night_schedule_temp', 3700)
            from_str = f"{self.config['night_schedule_from_hour']:02d}:{self.config['night_schedule_from_minute']:02d}"
            to_str = f"{self.config['night_schedule_to_hour']:02d}:{self.config['night_schedule_to_minute']:02d}"
            if state_changed or force:
                logger.info(f"Night schedule ACTIVE ({from_str} ~ {to_str}). Locking display to {target_k}K.")
                if self.config.get('enabled', True):
                    self._apply_temperature(target_k, f"Night Schedule Locked ({from_str}~{to_str})", force=True)
        else:
            if state_changed:
                logger.info("Night schedule ended. Resuming adaptive tone.")
                if self.config.get('enabled', True):
                    self._sync_now("Night Schedule Ended", force=True)

        self.schedule_timer_id = GLib.timeout_add_seconds(delta_sec, self._on_schedule_timer_tick)
        logger.debug(f"Next schedule transition in {delta_sec}s (active={self.is_in_night_schedule})")

    def _on_schedule_timer_tick(self) -> bool:
        self.schedule_timer_id = None
        self._evaluate_night_schedule()
        return False

    def _sync_now(self, reason: str = "", force: bool = True):
        """Immediately read sensor and update display temperature (bypassing hysteresis by default)."""
        if self.is_sleeping or not self.config.get('enabled', True):
            return
        if self.is_in_night_schedule and not reason.startswith("Night Schedule"):
            logger.debug("Night schedule active; bypassing sync_now.")
            return
        try:
            raw_k = self.sensor.read_color_temp()
            lux = self.sensor.read_illuminance()
            self.last_stable_ambient_k = raw_k
            self.last_stable_lux = lux
            self.pending_ambient_k = None
            target_display_k = map_ambient_to_display_cct(raw_k, self.config)
            self._apply_temperature(target_display_k, f"{reason} (Ambient: {raw_k:.0f}K, {lux:.1f}lx)", force=force)
        except Exception as e:
            logger.error(f"Error during immediate sync: {e}")

    def _update_polling_timer(self):
        """Manage optional fallback polling timer."""
        if self.polling_timer_id:
            GLib.source_remove(self.polling_timer_id)
            self.polling_timer_id = None

        if self.config['enable_polling'] and self.config['poll_interval'] > 0:
            interval_ms = int(self.config['poll_interval'] * 1000)
            self.polling_timer_id = GLib.timeout_add(interval_ms, self._on_polling_tick)
            logger.info(f"Fallback polling timer scheduled every {self.config['poll_interval']}s")
        else:
            logger.info("Pure Event-Driven mode: Fallback polling timer disabled.")

    def _on_polling_tick(self) -> bool:
        if not self.is_sleeping and self.config.get('enabled', True):
            self._process_sensor_update("Polling Tick")
        return True

    def _on_dbus_signal(self, connection, sender, path, iface, signal, params, user_data):
        """Handle iio-sensor-proxy D-Bus Property changes (0ms delay)."""
        if self.is_sleeping or not self.config.get('enabled', True):
            return
        if iface == 'org.freedesktop.DBus.Properties' and signal == 'PropertiesChanged':
            interface_name, changed_props, invalidated = params.unpack()
            if interface_name == 'net.hadess.SensorProxy':
                if 'LightLevel' in changed_props or 'LightLevelUnit' in changed_props:
                    self._process_sensor_update("D-Bus Event")

    def _process_sensor_update(self, reason: str = ""):
        """Process sensor readings with occlusion guard, glitch observation, and hysteresis."""
        if self.is_in_night_schedule:
            logger.debug("Night schedule active; ignoring sensor update.")
            return

        try:
            raw_cct = self.sensor.read_color_temp()
            lux = self.sensor.read_illuminance()
        except Exception as e:
            logger.warning(f"Failed to read sensor: {e}")
            return

        now = time.monotonic()

        # 1. Smart Occlusion Guard
        if lux < self.config['min_lux_threshold']:
            if self.occlusion_start_time is None:
                self.occlusion_start_time = now
                logger.debug(f"Low illuminance ({lux:.1f} lx) detected. Holding display tone.")
                # Re-check once the hold expires; in event-driven mode a steady dark room may emit no further events.
                if self.occlusion_timer_id is None:
                    self.occlusion_timer_id = GLib.timeout_add(
                        int(self.config['occlusion_hold_sec'] * 1000) + 50, self._on_occlusion_timer
                    )
                return
            elif (now - self.occlusion_start_time) < self.config['occlusion_hold_sec']:
                logger.debug(f"Holding tone during occlusion ({now - self.occlusion_start_time:.1f}s / {self.config['occlusion_hold_sec']}s)")
                return
            else:
                pass  # Legitimate dark room
        else:
            self.occlusion_start_time = None

        # 2. Hardware Sensor Low-Light Fallback Guard
        if self._is_hardware_fallback(raw_cct, lux):
            if self.pending_ambient_k is not None:
                self.pending_ambient_k = None
            self.fallback_suppressed_count += 1
            if self.fallback_suppressed_count % 5 == 1:
                logger.info(
                    f"Ignored hardware sensor fallback to 4500K (Ambient: {raw_cct:.0f}K, Lux: {lux:.1f}lx, "
                    f"Stable: {self.last_stable_ambient_k:.0f}K [suppressed x{self.fallback_suppressed_count}]). Holding current tone."
                )
            else:
                logger.debug(
                    f"Suppressed hardware fallback 4500K (Ambient: {raw_cct:.0f}K, Lux: {lux:.1f}lx)"
                )
            return
        else:
            self.fallback_suppressed_count = 0

        # 3. Glitch Observation Filter (Δ >= glitch_threshold)
        glitch_thresh = self.config['glitch_threshold']
        confirm_window = self.config['glitch_confirm_sec']
        ambient_delta = abs(raw_cct - self.last_stable_ambient_k)

        if ambient_delta >= glitch_thresh:
            if self.pending_ambient_k is None or abs(raw_cct - self.pending_ambient_k) > 150:
                self.pending_ambient_k = raw_cct
                self.pending_since = now
                logger.debug(f"Large jump detected (Δ={ambient_delta:.0f}K: {self.last_stable_ambient_k:.0f}K -> {raw_cct:.0f}K). Observing for {confirm_window:.1f}s...")
                
                # Schedule confirmation check
                GLib.timeout_add(int(confirm_window * 1000) + 50, self._check_pending_glitch)
                return
            else:
                elapsed = now - self.pending_since
                if elapsed < confirm_window:
                    logger.debug(f"Observing jump ({elapsed:.2f}s / {confirm_window:.1f}s)...")
                    return
                else:
                    self.last_stable_ambient_k = raw_cct
                    self.last_stable_lux = lux
                    self.pending_ambient_k = None
                    target_display_k = map_ambient_to_display_cct(raw_cct, self.config)
                    self._apply_temperature(
                        target_display_k,
                        f"Confirmed CCT shift (Ambient: {raw_cct:.0f}K -> Target: {target_display_k}K [Offset: {self.config['temp_offset']:+d}K], {lux:.1f}lx)",
                    )
                    return
        else:
            if self.pending_ambient_k is not None:
                logger.debug(f"Sensor returned to stable level ({raw_cct:.0f}K). Glitch ignored.")
                self.pending_ambient_k = None

            self.last_stable_ambient_k = raw_cct
            self.last_stable_lux = lux
            target_display_k = map_ambient_to_display_cct(raw_cct, self.config)
            self._apply_temperature(
                target_display_k,
                f"{reason} (Ambient: {raw_cct:.0f}K -> Target: {target_display_k}K [Offset: {self.config['temp_offset']:+d}K], {lux:.1f}lx)",
            )

    def _on_occlusion_timer(self) -> bool:
        self.occlusion_timer_id = None
        if self.occlusion_start_time is not None and not self.is_sleeping and self.config.get('enabled', True):
            self._process_sensor_update("Occlusion Hold Expired")
        return False

    def _check_pending_glitch(self) -> bool:
        """GLib callback to confirm sustained CCT shift."""
        if self.pending_ambient_k is None or self.is_sleeping or not self.config.get('enabled', True):
            return False

        now = time.monotonic()
        if (now - self.pending_since) >= self.config['glitch_confirm_sec']:
            try:
                current_cct = self.sensor.read_color_temp()
                current_lux = self.sensor.read_illuminance()

                # Guard against pending jump resolving to low-light hardware fallback
                if self._is_hardware_fallback(current_cct, current_lux):
                    logger.info(
                        f"Pending jump to {current_cct:.0f}K rejected as low-light hardware fallback (Lux: {current_lux:.1f}lx). "
                        f"Holding stable {self.last_stable_ambient_k:.0f}K."
                    )
                    self.pending_ambient_k = None
                    return False

                if abs(current_cct - self.pending_ambient_k) < 250:
                    self.last_stable_ambient_k = current_cct
                    self.last_stable_lux = current_lux
                    self.pending_ambient_k = None
                    target_display_k = map_ambient_to_display_cct(current_cct, self.config)
                    self._apply_temperature(
                        target_display_k,
                        f"Confirmed CCT shift (Ambient: {current_cct:.0f}K -> Target: {target_display_k}K [Offset: {self.config['temp_offset']:+d}K], {current_lux:.1f}lx)",
                    )
                else:
                    logger.debug(f"Transient spike passed ({self.pending_ambient_k:.0f}K -> {current_cct:.0f}K). Glitch ignored.")
                    self.pending_ambient_k = None
            except Exception as e:
                logger.warning(f"Error in glitch confirmation: {e}")
                self.pending_ambient_k = None
        return False

    def _apply_temperature(self, target_k: int, reason: str = "", force: bool = False):
        """Update display temperature if difference meets hysteresis threshold or forced."""
        if not force and abs(target_k - self.current_display_k) < self.config['update_threshold']:
            return

        logger.info(f"Target transition -> {target_k}K [Reason: {reason}]")
        self.current_display_k = float(target_k)
        self.controller.set_temperature(target_k)

    def _on_prepare_for_sleep(self, connection, sender, path, iface, signal, params, user_data):
        """Handle systemd suspend/resume events cleanly."""
        sleep_state = params.unpack()[0]
        if sleep_state:
            logger.info("System entering suspend. Pausing Adaptive Tone processing.")
            self.is_sleeping = True
            if self.resume_timer_id:
                GLib.source_remove(self.resume_timer_id)
                self.resume_timer_id = None
        else:
            logger.info("System resumed. Scheduling stabilization delay...")
            self.is_sleeping = True
            if self.resume_timer_id:
                GLib.source_remove(self.resume_timer_id)
            delay_ms = int(self.config['resume_delay_sec'] * 1000)
            self.resume_timer_id = GLib.timeout_add(delay_ms, self._on_resume_stable)

    def _on_resume_stable(self) -> bool:
        self.is_sleeping = False
        self.resume_timer_id = None
        logger.info("System stabilized post-resume. Resuming Adaptive Tone.")
        self._evaluate_night_schedule()
        if not self.is_in_night_schedule and self.config.get('enabled', True):
            self._sync_now("Resume Sync", force=True)
        return False

    def _clean_exit(self):
        if self._cleaned_up:
            return
        self._cleaned_up = True
        logger.info("Cleaning up Adaptive Tone Daemon...")
        if self.resume_timer_id:
            GLib.source_remove(self.resume_timer_id)
            self.resume_timer_id = None
        if self.polling_timer_id:
            GLib.source_remove(self.polling_timer_id)
            self.polling_timer_id = None
        if self.schedule_timer_id:
            GLib.source_remove(self.schedule_timer_id)
            self.schedule_timer_id = None
        if self.occlusion_timer_id:
            GLib.source_remove(self.occlusion_timer_id)
            self.occlusion_timer_id = None
        if self.sensor_proxy:
            try:
                self.sensor_proxy.ReleaseLight()
            except Exception:
                pass
        self.controller.restore_original_settings()

    def run(self):
        logger.info("Starting GNOME Adaptive Tone Daemon v3.3.0...")
        logger.info(f"Sensor Device: {self.sensor.device_path} ({self.sensor.device_name})")
        logger.info(f"Transfer Range: Ambient [{self.config['ambient_min']}K-{self.config['ambient_max']}K] -> Display [{self.config['display_min']}K-{self.config['display_max']}K] (Offset: {self.config['temp_offset']:+d}K)")
        
        if self.config['enable_polling'] and self.config['poll_interval'] > 0:
            logger.info(f"Fallback Polling: ENABLED (every {self.config['poll_interval']}s)")
        else:
            logger.info("Fallback Polling: DISABLED (100% Pure Event-Driven Mode)")

        if self.config.get('enabled', True):
            self._evaluate_night_schedule(force=True)
            if not self.is_in_night_schedule:
                # Initial sync: calculate and set target temperature BEFORE enabling Night Light to eliminate 3700K flash
                raw_k = self.sensor.read_color_temp()
                raw_lux = self.sensor.read_illuminance()
                self.last_stable_ambient_k = raw_k
                self.last_stable_lux = raw_lux
                self.pending_ambient_k = None
                initial_target = map_ambient_to_display_cct(raw_k, self.config)
                self.current_display_k = float(initial_target)
                self.controller.set_temperature(initial_target)
                self.controller.enable_all_day_mode()
                logger.info(f"Initial white-point set to {initial_target}K (Ambient: {raw_k:.0f}K, Offset: {self.config['temp_offset']:+d}K)")
            else:
                self.controller.enable_all_day_mode()

        # Setup D-Bus
        try:
            self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            
            # 1. ALS sensor proxy signal
            self.system_bus.signal_subscribe(
                'net.hadess.SensorProxy',
                'org.freedesktop.DBus.Properties',
                'PropertiesChanged',
                '/net/hadess/SensorProxy',
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_dbus_signal,
                None
            )
            self.sensor_proxy = Gio.DBusProxy.new_sync(
                self.system_bus,
                Gio.DBusProxyFlags.NONE,
                None,
                'net.hadess.SensorProxy',
                '/net/hadess/SensorProxy',
                'net.hadess.SensorProxy',
                None
            )
            self.sensor_proxy.ClaimLight()
            logger.info("Connected to iio-sensor-proxy D-Bus events successfully.")

            # 2. Systemd-logind PrepareForSleep signal
            self.system_bus.signal_subscribe(
                'org.freedesktop.login1',
                'org.freedesktop.login1.Manager',
                'PrepareForSleep',
                '/org/freedesktop/login1',
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_prepare_for_sleep,
                None
            )
            logger.info("Subscribed to systemd-logind PrepareForSleep events successfully.")
        except Exception as e:
            logger.warning(f"D-Bus connection warning: {e}. If polling is disabled, sensor events may be missed.")

        # Setup periodic fallback timer if enabled
        self._update_polling_timer()

        # Setup signals
        def sig_handler(signum, frame):
            if self.loop and self.loop.is_running():
                self.loop.quit()

        signal.signal(signal.SIGINT, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)
        signal.signal(signal.SIGHUP, sig_handler)
        atexit.register(self._clean_exit)

        self.loop = GLib.MainLoop()
        try:
            self.loop.run()
        finally:
            self._clean_exit()


def open_preferences_gui():
    """Launch Extension Preferences Window."""
    try:
        res = subprocess.run(["gnome-extensions", "prefs", EXTENSION_UUID], check=False)
        if res.returncode == 0:
            return
    except Exception:
        pass
    
    print("Launching GNOME Extension preferences...")
    os.system(f"gnome-extensions prefs {EXTENSION_UUID} &")


